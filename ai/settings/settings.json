{
  "$schema": "./settings.schema.json",
  "version": 2,
  "allowCoAuthoredEtc": false,
  "pre_commit": {
    "yarn@4": {
      "enabled": true
    }
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Bash|shell|unified_exec|Write|Edit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/permission-check.py\"",
            "timeout": 5,
            "statusMessage": "Checking command policy..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-compact-prompt/hook.py\" 'claude'",
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-compact-prompt/hook.py\" 'claude'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/settings/sync.py\"",
            "statusMessage": "Syncing AI tool settings",
            "async": true
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/°base/init/checkout.sh\"",
            "statusMessage": "Setting up git hooks",
            "async": true
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/record-memory/hook.py\"",
            "statusMessage": "Syncing memory hardlinks",
            "async": true
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/record-codex-memory/hook.py\" 'claude'",
            "statusMessage": "Committing Codex memory",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|request_user_input|ask_user",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-decision/hook.py\" 'claude'",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|request_user_input|ask_user",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-decision/hook.py\" 'claude'",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|shell|unified_exec",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/record-memory/hook.py\"",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit|Read|Bash|shell|unified_exec|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-command-decision/hook.py\" 'claude'",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|shell|unified_exec|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/record-codex-memory/hook.py\" 'claude'",
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit|ExitPlanMode|create|edit|exit_plan_mode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-plan/hook.py\" 'claude'",
            "async": true
          }
        ]
      },
      {
        "matcher": "TodoWrite|update_todo|TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-plan/hook.py\" 'claude'",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-plan/hook.py\" 'claude'",
            "async": true
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/record-codex-memory/hook.py\" 'claude'",
            "timeout": 30,
            "async": true
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-decision/hook.py\" 'claude'",
            "async": true
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-command-decision/hook.py\" 'claude'",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/plan-style-context/hook.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-prompt/hook.py\" 'claude'",
            "async": true
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/save-command-decision/hook.py\" 'claude'",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/debug-log/hook.py\" 'SubagentStop'",
            "async": true
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/debug-log/hook.py\" 'TaskCreated'",
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/debug-log/hook.py\" 'TaskCompleted'",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "agent_completed",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/°base/ai/hooks/debug-log/hook.py\" 'Notification-agent_completed'",
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      {"type": "bash", "command": "tree:*"},
      {"type": "bash", "command": "ls:*"},
      {"type": "bash", "command": "yarn"},
      {"type": "bash", "command": "make"},
      {"type": "bash", "command": "which python"},
      {"type": "bash", "command": "python --version"},
      {"type": "bash", "command": "pip show:*"},
      {"type": "bash", "command": "pip3 show:*"},
      {"type": "bash", "command": "uv pip show:*"},
      {"type": "bash", "command": "pip index versions:*"},
      {"type": "bash", "command": "pip3 index versions:*"},
      {"type": "bash", "command": "uv --version"},
      {"type": "bash", "command": "uv python list"},
      {"type": "bash", "command": "uv pip index versions:*"},
      {"type": "bash", "command": "nvm use:*"},
      {"type": "bash", "command": "poetry install:*"},
      {"type": "bash", "command": "yarn install:*"},
      {"type": "bash", "command": "corepack yarn@4.9.2 install:*"},
      {"type": "bash", "command": "uv sync:*"},
      {"type": "bash", "command": "uv lock *"},
      {"type": "bash", "command": "npx vue-tsc:*"},
      {"type": "bash", "command": "npx vitest:*"},
      {"type": "bash", "command": "npx tsc *"},
      {"type": "bash", "command": "./node_modules/.bin/tsc --noEmit"},
      {"type": "bash", "command": "node_modules/.bin/tsc --version"},
      {"type": "bash", "command": "node_modules/.bin/tsc --noEmit"},
      {"type": "bash", "command": "uv run ruff check:*"},
      {"type": "bash", "command": "uv run pytest:*"},
      {"type": "bash", "command": "uv run python -m pytest:*"},
      {"type": "bash", "command": "poetry run pytests:*"},
      {"type": "bash", "command": "python3 -m unittest:*"},
      {"type": "bash", "command": "npm test:*"},
      {"type": "bash", "command": "yarn test:*"},
      {"type": "bash", "command": "yarn test:unit:*"},
      {"type": "bash", "command": "yarn test:coverage:*"},
      {"type": "bash", "command": "cargo test:*"},
      {"type": "bash", "command": "python -m py_compile:*"},
      {"type": "bash", "command": "yarn build-check:*"},
      {"type": "bash", "command": "yarn run type-check"},
      {"type": "bash", "command": "yarn run type-check:*"},
      {"type": "bash", "command": "yarn run lint"},
      {"type": "bash", "command": "yarn run lint:*"},
      {"type": "bash", "command": "yarn run tsc:*"},
      {"type": "bash", "command": "yarn type-check:*"},
      {"type": "bash", "command": "yarn lint:*"},
      {"type": "bash", "command": "yarn eslint:*"},
      {"type": "bash", "command": "yarn tsc:*"},
      {"type": "bash", "command": "yarn fix:*"},
      {"type": "bash", "command": "yarn build:*"},
      {"type": "bash", "command": "yarn build-only *"},
      {"type": "bash", "command": "yarn test:unit"},
      {"type": "bash", "command": "yarn test:e2e:pw:*"},
      {"type": "bash", "command": "yarn run test:unit"},
      {"type": "bash", "command": "yarn run test:e2e:pw:*"},
      {"type": "bash", "command": "npm view:*"},
      {"type": "bash", "command": "cargo check:*"},
      {"type": "bash", "command": "corepack yarn@4.9.2 add:*"},
      {"type": "bash", "command": "yarn add:*"},
      {"type": "bash", "command": "uv add:*"},
      {"type": "bash", "command": "echo \"exit: $?\""},
      {"type": "bash", "command": "git add:*"},
      {"type": "bash", "command": "git log:*"},
      {"type": "bash", "command": "git diff:*"},
      {"type": "bash", "command": "git status:*"},
      {"type": "bash", "command": "git show:*"},
      {"type": "bash", "command": "git config user.name"},
      {"type": "bash", "command": "git config user.email"},
      {"type": "bash", "command": "git config --local user.name"},
      {"type": "bash", "command": "git config --local user.email"},
      {"type": "bash", "command": "git config --global user.name"},
      {"type": "bash", "command": "git config --global user.email"},
      {"type": "bash", "command": "git branch --show-current"},
      {"type": "bash", "command": "git ls-tree:*"},
      {"type": "bash", "command": "git check-ignore:*"},
      {"type": "bash", "command": "git fetch:*"},
      {"type": "bash", "command": "git stash:*"},
      {"type": "bash", "command": "git commit --amend --reset-author --no-edit"},
      {"type": "bash", "command": "make commit:*"},
      {"type": "bash", "command": "rm ai/git/pending-commit.md || echo 'was gone'"},
      {"type": "bash", "command": "rm ai/git/pending-commit.md"},
      {"type": "bash", "command": "./scripts/tag_backup.py && git commit -F ai/git/pending-commit.md"},
      {"type": "bash", "command": "./scripts/tag_backup.py"},
      {"type": "bash", "command": "git commit -F ai/git/pending-commit.md && ./scripts/tag_backup.py"},
      {"type": "bash", "command": "git commit -F ai/git/pending-commit.md"},
      {"type": "bash", "command": "git commit --amend -F ai/git/pending-commit.md"},
      {"type": "bash", "command": "git lfs install"},
      {"type": "bash", "command": "command -v pre-commit"},
      {"type": "bash", "command": "git rebase --continue"},
      {"type": "bash", "command": "pkill -f \"vite\""},
      {"type": "bash", "command": "tree"},
      {"type": "bash", "command": "python3 -m json.tool"},
      {"type": "bash", "command": "python -m json.tool"},
      {"type": "bash", "command": "xargs -I{} ls -la {}"},
      {"type": "skill", "name": "commit-with-lplp-style"},
      {"type": "skill", "name": "/commit-with-lplp-style"},
      {"type": "read", "path": "ai/skills/commit-with-lplp-style/SKILL.md"},
      {"type": "read", "path": "./ai/skills/commit-with-lplp-style/SKILL.md"},
      {"type": "bash", "command": "uv run --project scripts/°base python -m unittest:*"},
      {"type": "bash", "command": "uv run --project \"scripts/°base\" python -m unittest:*"},
      {"type": "bash", "command": "python3 scripts/°base/ai/hooks/save-prompt/hook.py"},
      {"type": "bash", "command": "python3 -m pytest scripts/°base/tests/test_permission_check.py:*"},
      {"type": "bash", "command": "python3 -m pytest scripts/°base/init/checkout.sh"},
      {"type": "bash", "command": "GIT_SEQUENCE_EDITOR=/tmp/git-rebase-todo.sh git *"},
      {"type": "bash", "command": "uv run fastapi --help"},
      {"type": "bash", "command": "python3 \"scripts/°base/ai/settings/sync.py\""},
      {"type": "bash", "command": "python3 scripts/°base/ai/settings/sync.py:*"},
      {"type": "bash", "command": "python scripts/°base/ai/settings/sync.py:*"},
      {"type": "bash", "command": "uv run --directory scripts/°base python -m ai.settings.sync:*"},
      {"type": "bash", "command": "./scripts/°base/ai/settings/sync.py"},
      {"type": "bash", "command": "GIT_SEQUENCE_EDITOR=/tmp/git-rebase-todo.sh git rebase *"},
      {"type": "bash", "command": "env UV_CACHE_DIR=/tmp/uv-cache DOWNLOAD_LINK_LIVE=1 uv run --project scripts/°base python -m unittest scripts/°base/tests/test_download_link_live.py -v"},
      {"type": "bash", "command": "env UV_CACHE_DIR=/tmp/uv-cache ./scripts/°base/ai/references/download-link.py:*"},
      {"type": "bash", "command": "./scripts/°base/ai/references/download-link.py:*"},
      {"type": "bash", "command": "../scripts/°base/init/link-subproject-claude.sh"},
      {"type": "bash", "command": "mv .claude/settings.local.json \".claude.settings.local.json.$(date +%Y-%m-%d).bak\""},
      {"type": "mcp", "server": "bugsink", "tool": "list_projects"},
      {"type": "mcp", "server": "bugsink", "tool": "list_issues"},
      {"type": "mcp", "server": "bugsink", "tool": "get_issue"},
      {"type": "bash", "command": "echo \"---\""},
      {"type": "bash", "command": "echo ---"},
      {"type": "bash", "command": "echo '---'"}
    ],
    "deny": [
      {"type": "read", "path": "**/.env*"},
      {"type": "read", "path": "**/*.env*.bak"},
      {"type": "read", "path": "**/env.php*"},
      {"type": "read", "path": "**/*.pem"},
      {"type": "read", "path": "**/*.key"},
      {"type": "read", "path": "**/secrets/**"},
      {"type": "read", "path": "**/credentials/**"},
      {"type": "read", "path": "**/.aws/**"},
      {"type": "read", "path": "**/.ssh/**"}
    ]
  },
  "plugins": {
    "openai-developers@openai-developers": {
      "enabled": true
    },
    "skill-creator@claude-plugins-official": {
      "enabled": true
    }
  },
  "mcp": {
    "tools": {
      ".env": {
        "": {
          "mode": "prefix",
          "cmd": ["npx", "-y", "envmcp", "--env-file", "ai/.env"]
        },
        "repo-root": {
          "mode": "prefix",
          "cmd": ["npx", "-y", "envmcp", "--env-file", "$(git rev-parse --show-toplevel)/.env"]
        },
        "debug": {
          "mode": "prefix",
          "cmd": ["npx", "-y", "mcpipe", "--debug", "--env-file", "ai/.env"]
        }
      }
    },
    "servers": {
      "bugsink": {
        "enabled": false,
        "type": "stdio",
        "tools": [
          ".env"
        ],
        "cmd": ["npx", "-y", "bugsink-mcp"]
      },
      "chrome-devtools": {
        "enabled": false,
        "type": "stdio",
        "tools": [],
        "cmd": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect", "--no-usage-statistics"]
      },
      "sync_todo": {
        "enabled": false,
        "type": "stdio",
        "tools": [
          ".env"
        ],
        "cmd": ["npx", "-y", "mcp-remote", "\"$SYNC_TODO_MCP_URL\"", "--header", "\"Authorization:Bearer $SYNC_TODO_MCP_TOKEN\""]
      },
      "coolify": {
        "enabled": false,
        "type": "stdio",
        "tools": [
          ".env"
        ],
        "cmd": ["npx", "-y", "mcp-remote", "\"$COOLIFY_URL\"", "--header", "\"Authorization:Bearer $COOLIFY_TOKEN\""]
      }
    }
  },
  "download_link": {
    "ide": "pycharm"
  }
}
